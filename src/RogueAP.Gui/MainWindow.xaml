<Window x:Class="RogueAP.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RogueAP Shield" Height="860" Width="1200" MinHeight="760" MinWidth="1040"
        Icon="Assets/logo.ico"
        Background="{StaticResource BrushBackground}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!-- Root: Sidebar (220) + Main (*) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════ SIDEBAR ═══════════════════════════════ -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E4E4E7"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Header -->
                <Border DockPanel.Dock="Top"
                        Padding="16"
                        BorderBrush="#E4E4E7"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Source="Assets/logo-icon.png"
                               Width="28" Height="28"
                               Margin="0 0 10 0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RogueAP Shield"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Protection active"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Profile Footer -->
                <Border DockPanel.Dock="Bottom"
                        Padding="12,16"
                        BorderBrush="#E4E4E7"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SidebarProfileIconBorder"
                                Width="32" Height="32" CornerRadius="16"
                                Background="#EFF6FF">
                            <TextBlock x:Name="SidebarProfileIcon"
                                       Text="HM"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="#185FA5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock x:Name="SidebarProfileText"
                                       Text="Home" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Active profile"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,8">

                        <!-- MONITOR section -->
                        <TextBlock Text="MONITOR"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Margin="16,12,0,4"/>

                        <!-- Dashboard nav item -->
                        <Border x:Name="NavBorderDashboard" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0"
                                    Click="NavDashboard_Click" Cursor="Hand"
                                    HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NavTextDashboard" Text="Dashboard" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Border>

                        <!-- Nearby Networks -->
                        <Border x:Name="NavBorderNearby" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0"
                                    Click="NavNearby_Click" Cursor="Hand"
                                    HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NavTextNearby" Text="Nearby Networks" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Border>

                        <!-- Activity Log -->
                        <Border x:Name="NavBorderLog" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0"
                                    Click="NavLog_Click" Cursor="Hand"
                                    HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NavTextLog" Text="Activity Log" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Border>

                        <!-- MANAGE section -->
                        <TextBlock Text="MANAGE"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Margin="16,12,0,4"/>

                        <!-- Trusted Networks -->
                        <Border x:Name="NavBorderTrusted" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0"
                                    Click="NavTrusted_Click" Cursor="Hand"
                                    HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NavTextTrusted" Text="Trusted Networks" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Border>

                        <!-- Security Keys -->
                        <Border x:Name="NavBorderKeys" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0"
                                    Click="NavKeys_Click" Cursor="Hand"
                                    HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NavTextKeys" Text="Recovery" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Border>

                        <!-- VPN and Firewall -->
                        <Border x:Name="NavBorderVpn" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0"
                                    Click="NavVpn_Click" Cursor="Hand"
                                    HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NavTextVpn" Text="VPN &amp; Firewall" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Border>

                        <!-- SYSTEM section -->
                        <TextBlock Text="SYSTEM"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Margin="16,12,0,4"/>

                        <!-- Settings -->
                        <Border x:Name="NavBorderSettings" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Background="Transparent" BorderThickness="0"
                                    Click="NavSettings_Click" Cursor="Hand"
                                    HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="NavTextSettings" Text="Settings" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════ MAIN CONTENT ═══════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4E4E7"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PageTitleText"
                               Text="Dashboard"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">

                        <!-- Refresh label + combo -->
                        <TextBlock Text="Refresh:"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <ComboBox x:Name="DashboardRefreshIntervalComboBox"
                                  Width="56" FontSize="12"
                                  Margin="0,0,10,0"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="DashboardRefreshIntervalComboBox_SelectionChanged">
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="30"/>
                        </ComboBox>

                        <!-- Status chip -->
                        <Border x:Name="TopBarStatusChip"
                                Style="{StaticResource ChipStyle}"
                                Background="#F0FDF4"
                                BorderBrush="#86EFAC"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TopBarStatusText"
                                       Text="Protected"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="#166534"/>
                        </Border>

                        <!-- Last updated -->
                        <TextBlock x:Name="DashboardLastUpdateText"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <!-- ApiBaseUrlTextBox kept hidden for code-behind compatibility -->
                        <TextBox x:Name="ApiBaseUrlTextBox"
                                 Width="200" FontSize="11"
                                 Text="http://127.0.0.1:5088"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"/>

                        <!-- Manual refresh button -->
                        <Button Content="Refresh" FontSize="12"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center"
                                Click="RefreshDashboard_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAGE CONTENT — one panel per nav page, toggled by Nav*_Click -->
            <Grid Grid.Row="1">

                <!-- ═══════ DASHBOARD PAGE ═══════ -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Margin="20">

                    <!-- ── ENFORCEMENT ALERT ── -->
                    <Border x:Name="DashboardWarningBorder"
                            CornerRadius="8" Padding="14,12"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Ellipse Width="8" Height="8" Fill="#A32D2D"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DashboardSimilarSsidWarningText"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DashboardEnforcementText"
                                               FontSize="11" FontWeight="Normal"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Revert block"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Click="RevertNetworkBlock_Click"/>
                        </Grid>
                    </Border>

                    <!-- ── RISK HERO CARD ── -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Gauge column -->
                            <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,20,0">
                                <Ellipse x:Name="RiskGaugeBackground"
                                         Stroke="#E4E4E7"
                                         StrokeThickness="8"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="RiskGaugeArc"
                                         Stroke="#3B6D11"
                                         StrokeThickness="8"
                                         Fill="Transparent"
                                         StrokeDashArray="0 257.6"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="RiskGaugeScore"
                                               Text="0"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               Foreground="#3B6D11"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="/ 100"
                                               FontSize="10"
                                               Foreground="#A1A1AA"
                                               HorizontalAlignment="Center"
                                               Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Info column -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">

                                <!-- Risk level badge -->
                                <Border x:Name="RiskLevelBadge"
                                        CornerRadius="20"
                                        Padding="10,4"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8"
                                        Background="#F0FDF4"
                                        BorderBrush="#86EFAC"
                                        BorderThickness="1">
                                    <TextBlock x:Name="DashboardRiskText"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="#3B6D11"/>
                                </Border>

                                <!-- Connected network -->
                                <TextBlock x:Name="DashboardConnectedText"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#18181B"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>

                                <!-- Network details -->
                                <TextBlock x:Name="DashboardNetworkDetailsText"
                                           FontSize="11"
                                           Foreground="#71717A"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <!-- Signals list -->
                                <ItemsControl x:Name="RiskSignalsControl"
                                              Margin="0,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Width="6" Height="6"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0"
                                                         Fill="{Binding DotColor}"/>
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="11"
                                                           Foreground="#71717A"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Actions column -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="120">
                                <Button Click="VpnConnect_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,0,8"
                                        Padding="8,8"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="Connect VPN"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="11"/>
                                </Button>
                                <Button Click="TrustConnectedAp_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,0,8"
                                        Padding="8,8"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="Trust connected AP"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="11"/>
                                </Button>
                                <Button Click="NearbyWifiScan_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,8"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="Scan now"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── STAT CARDS ROW ── -->
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <!-- Service card -->
                        <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="Service"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="DashboardHealthText"
                                           FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock x:Name="DashboardMasterKeyText"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- VPN card -->
                        <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="VPN"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="DashboardVpnText"
                                           FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Tunnel status"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Trusted networks card -->
                        <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Trusted networks"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="DashboardTrustedCountText"
                                           FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="On this device"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ── PROFILE DISPLAY (read-only) ── -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Active profile:"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0 0 8 0"/>
                            <Border x:Name="DashboardProfileIconBorder"
                                    Width="24" Height="24" CornerRadius="12"
                                    Background="#EFF6FF"
                                    Margin="0 0 6 0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="DashboardProfileIcon"
                                           Text="HM"
                                           FontSize="9" FontWeight="Medium"
                                           Foreground="#185FA5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="DashboardProfileLabel"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ── CONNECTION DETAILS CARD ── -->
                    <Border Style="{StaticResource Card}" Margin="0 0 0 14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Network info -->
                            <StackPanel Grid.Column="0" Margin="0 0 16 0">
                                <TextBlock Text="Network" FontSize="11"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0 0 0 6"/>
                                <TextBlock x:Name="DetailSsidText"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailBssidText"
                                           FontSize="11" FontFamily="Consolas"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0 2 0 0"/>
                                <TextBlock x:Name="DetailSecurityText"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 2 0 0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                                       Fill="#E4E4E7" Margin="0 4"/>

                            <!-- Column 1: Gateway info -->
                            <StackPanel Grid.Column="1" Margin="16 0">
                                <TextBlock Text="Gateway" FontSize="11"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0 0 0 6"/>
                                <TextBlock x:Name="DetailGatewayText"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock x:Name="DetailTtlText"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 2 0 0"/>
                                <TextBlock x:Name="DetailBandText"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 2 0 0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right"
                                       Fill="#E4E4E7" Margin="0 4"/>

                            <!-- Column 2: Protection status -->
                            <StackPanel Grid.Column="2" Margin="16 0 0 0">
                                <TextBlock Text="Protection" FontSize="11"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0 0 0 6"/>
                                <TextBlock x:Name="DetailProtectionText"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock x:Name="DetailLearningText"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0 2 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- NearbyWifiListBox kept hidden for code-behind binding compatibility -->
                    <ListBox x:Name="NearbyWifiListBox"
                             Visibility="Collapsed"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="240">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E4E4E7"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F4F4F5"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,10" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Signal bars -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Width="28" HorizontalAlignment="Center">
                                                <Rectangle Width="4" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Height" Value="6"/>
                                                            <Setter Property="Fill" Value="#E4E4E7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAnySignal}" Value="True">
                                                                    <Setter Property="Fill" Value="{Binding SignalColor}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <Rectangle Width="4" Height="10" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Margin="2 0 0 0">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="#E4E4E7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SignalBars}" Value="2"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SignalBars}" Value="3"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SignalBars}" Value="4"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <Rectangle Width="4" Height="14" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Margin="2 0 0 0">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="#E4E4E7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SignalBars}" Value="3"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SignalBars}" Value="4"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <Rectangle Width="4" Height="18" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Margin="2 0 0 0">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="#E4E4E7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SignalBars}" Value="4"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </StackPanel>

                                            <!-- SSID + BSSID + Security -->
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Ssid}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#18181B"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Bssid}"
                                                               FontSize="11"
                                                               FontFamily="Consolas"
                                                               Foreground="#A1A1AA"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="11"
                                                               Foreground="#A1A1AA"/>
                                                    <Border CornerRadius="4"
                                                            Padding="5,1"
                                                            Margin="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F4F4F5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShortSecurity}" Value="Open">
                                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ShortSecurity}" Value="WPA3">
                                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ShortSecurity}"
                                                                   FontSize="10"
                                                                   FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#71717A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShortSecurity}" Value="Open">
                                                                            <Setter Property="Foreground" Value="#A32D2D"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ShortSecurity}" Value="WPA3">
                                                                            <Setter Property="Foreground" Value="#3B6D11"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Signal strength -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SignalStrength, StringFormat='{}{0} dBm'}"
                                                       FontSize="12"
                                                       Foreground="#71717A"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>

                                            <!-- Trust badge -->
                                            <Border Grid.Column="3"
                                                    CornerRadius="20"
                                                    Padding="10,3"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F4F4F5"/>
                                                        <Setter Property="BorderBrush" Value="#E4E4E7"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTrusted}" Value="True">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TrustLabel}"
                                                           FontSize="10"
                                                           FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#71717A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTrusted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#3B6D11"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                                    <Setter Property="Foreground" Value="#A32D2D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                    <!-- Hidden DeploymentProfileComboBox kept for code-behind compatibility -->
                    <ComboBox x:Name="DeploymentProfileComboBox" Visibility="Collapsed" SelectedIndex="0">
                        <ComboBoxItem Content="Home"/>
                        <ComboBoxItem Content="Enterprise"/>
                        <ComboBoxItem Content="Campus"/>
                    </ComboBox>

                    </StackPanel>
                </ScrollViewer>
                <!-- END DASHBOARD PAGE -->

                <!-- ═══════ NEARBY NETWORKS PAGE ═══════ -->
                <ScrollViewer x:Name="PageNearby" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Header row -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nearby Networks"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="Scan for access points and check their trust status."
                                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Sort by signal"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,6,0"
                                                Click="SortNearby_Click"/>
                                        <Button Content="Sort by SSID"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,6,0"
                                                Click="SortNearbyByName_Click"/>
                                        <Button Content="Scan"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,6,0"
                                                Click="NearbyWifiScan_Click"/>
                                        <Button Content="Add selected as trusted"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="TrustedAddSelected_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Full nearby list — shared backing collection, no MaxHeight -->
                                <ListBox x:Name="NearbyWifiListBoxFull"
                                         SelectionMode="Single"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E4E4E7"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F4F4F5"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,10" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Width="28" HorizontalAlignment="Center">
                                                    <Rectangle Width="4" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Height" Value="6"/>
                                                                <Setter Property="Fill" Value="#E4E4E7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAnySignal}" Value="True">
                                                                        <Setter Property="Fill" Value="{Binding SignalColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                    <Rectangle Width="4" Height="10" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Margin="2 0 0 0">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="#E4E4E7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SignalBars}" Value="2"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SignalBars}" Value="3"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SignalBars}" Value="4"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                    <Rectangle Width="4" Height="14" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Margin="2 0 0 0">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="#E4E4E7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SignalBars}" Value="3"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SignalBars}" Value="4"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                    <Rectangle Width="4" Height="18" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Margin="2 0 0 0">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="#E4E4E7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SignalBars}" Value="4"><Setter Property="Fill" Value="{Binding SignalColor}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Ssid}" FontSize="13" FontWeight="Medium" Foreground="#18181B"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Bssid}" FontSize="11" FontFamily="Consolas" Foreground="#A1A1AA"/>
                                                        <TextBlock Text=" · " FontSize="11" Foreground="#A1A1AA"/>
                                                        <Border CornerRadius="4" Padding="5,1" Margin="0,0,0,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F4F4F5"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShortSecurity}" Value="Open">
                                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ShortSecurity}" Value="WPA3">
                                                                            <Setter Property="Background" Value="#F0FDF4"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ShortSecurity}" FontSize="10" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#71717A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShortSecurity}" Value="Open">
                                                                                <Setter Property="Foreground" Value="#A32D2D"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ShortSecurity}" Value="WPA3">
                                                                                <Setter Property="Foreground" Value="#3B6D11"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SignalStrength, StringFormat='{}{0} dBm'}"
                                                           FontSize="12" Foreground="#71717A"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Border Grid.Column="3" CornerRadius="20" Padding="10,3" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F4F4F5"/>
                                                            <Setter Property="BorderBrush" Value="#E4E4E7"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTrusted}" Value="True">
                                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                                    <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding TrustLabel}" FontSize="10" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#71717A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTrusted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#3B6D11"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                                        <Setter Property="Foreground" Value="#A32D2D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══════ ACTIVITY LOG PAGE ═══════ -->
                <ScrollViewer x:Name="PageLog" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Activity log"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="AuditChainStatusText"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Verify integrity"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"
                                            Click="AuditVerify_Click"/>
                                    <Button Grid.Column="2"
                                            Content="Refresh"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="AuditRefresh_Click"/>
                                </Grid>

                                <ItemsControl x:Name="AuditLogItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E4E4E7"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="4,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="8" Height="8"
                                                            CornerRadius="4"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#A1A1AA"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Category}" Value="ENFORCEMENT">
                                                                        <Setter Property="Background" Value="#A32D2D"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Category}" Value="RISK">
                                                                        <Setter Property="Background" Value="#854F0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Category}" Value="TRUST">
                                                                        <Setter Property="Background" Value="#3B6D11"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Category}" Value="AUTH">
                                                                        <Setter Property="Background" Value="#185FA5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ParsedTimestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                               FontSize="11"
                                                               FontFamily="Consolas"
                                                               Foreground="#A1A1AA"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Action}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="#18181B"/>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="11"
                                                                   Foreground="#71717A"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Category}"
                                                               FontSize="10"
                                                               Foreground="#A1A1AA"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="AuditEmptyText"
                                           Text="No audit entries yet."
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,20"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══════ TRUSTED NETWORKS PAGE ═══════ -->
                <ScrollViewer x:Name="PageTrusted" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Trusted networks"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="TrustedCountLabel"
                                                   FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Refresh"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,6,0"
                                                Click="TrustedRefresh_Click"/>
                                        <Button Content="Scan and add"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="NearbyWifiScan_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Trusted list -->
                                <ListBox x:Name="TrustedNetworkListBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E4E4E7"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F4F4F5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32"
                                                        CornerRadius="6" Background="#F0FDF4">
                                                    <TextBlock Text="T" FontSize="13" FontWeight="Medium"
                                                               Foreground="#3B6D11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Ssid}" FontSize="13"
                                                               FontWeight="Medium" Foreground="#18181B"/>
                                                    <TextBlock Text="{Binding Bssid}" FontSize="11"
                                                               FontFamily="Consolas" Foreground="#A1A1AA"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SecurityProtocol}" FontSize="11"
                                                               Foreground="#71717A"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ShortDate}"
                                                           FontSize="11" Foreground="#A1A1AA"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Button Grid.Column="3"
                                                        Content="Remove"
                                                        VerticalAlignment="Center"
                                                        Tag="{Binding Bssid}"
                                                        Click="TrustedRemoveInline_Click"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Foreground="#A32D2D"
                                                        BorderBrush="#FCA5A5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="TrustedEmptyText"
                                           Text="No trusted networks added yet. Scan nearby networks and add them as trusted."
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,16,0,8"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- TrustedRemoveBssidTextBox kept hidden for code-behind compatibility -->
                        <TextBox x:Name="TrustedRemoveBssidTextBox" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══════ SECURITY KEYS PAGE ═══════ -->
                <ScrollViewer x:Name="PageKeys" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20">

                        <!-- Recovery & Reset heading -->
                        <Border Style="{StaticResource Card}" Margin="0 0 0 14">
                            <StackPanel>
                                <TextBlock Text="Reset master key using recovery key"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0 0 0 4"/>
                                <TextBlock Text="If you have forgotten your master key, enter your saved recovery key below along with a new master key and recovery key. Your recovery key was generated during initial setup."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0 0 0 16"/>

                                <TextBlock Text="Recovery key (from your saved backup)"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 0 0 4"/>
                                <PasswordBox x:Name="RecoverOldKeyBox"
                                             FontSize="12" Padding="8,6"
                                             BorderBrush="#E4E4E7"
                                             Margin="0 0 0 12"/>

                                <TextBlock Text="New master key"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 0 0 4"/>
                                <PasswordBox x:Name="RecoverNewMasterKeyBox"
                                             FontSize="12" Padding="8,6"
                                             BorderBrush="#E4E4E7"
                                             Margin="0 0 0 12"/>

                                <TextBlock Text="New recovery key (will replace old one)"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 0 0 4"/>
                                <PasswordBox x:Name="RecoverNewRecoveryKeyBox"
                                             FontSize="12" Padding="8,6"
                                             BorderBrush="#E4E4E7"
                                             Margin="0 0 0 16"/>

                                <Button Content="Recover"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Click="MasterKeyRecover_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- System reset -->
                        <Border Style="{StaticResource Card}" Margin="0 0 0 14"
                                BorderBrush="#FCA5A5" Background="#FFF5F5">
                            <StackPanel>
                                <TextBlock Text="Danger Zone"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#A32D2D"
                                           Margin="0 0 0 4"/>
                                <TextBlock Text="Reset all RogueAP data including trusted networks and keys. This cannot be undone."
                                           FontSize="12" Foreground="#A32D2D"
                                           TextWrapping="Wrap" Margin="0 0 0 12"/>
                                <Button Content="System Reset (Master Key)"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Click="SystemReset_Click"/>
                                <TextBlock Text="You will be prompted for your master key before reset proceeds."
                                           FontSize="11"
                                           Foreground="#A32D2D"
                                           Margin="0 6 0 0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Hidden stubs for code-behind compatibility -->
                        <Border x:Name="KeysResultCard" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="KeysResultTitle"/>
                                <TextBlock x:Name="KeysResultText"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══════ VPN & FIREWALL PAGE ═══════ -->
                <ScrollViewer x:Name="PageVpn" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20">

                        <!-- Status card -->
                        <Border Style="{StaticResource Card}" Margin="0 0 0 14">
                            <StackPanel>
                                <TextBlock Text="VPN protection"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0 0 0 14"/>

                                <Grid Margin="0 0 0 16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="VpnStatusDot"
                                                 Width="12" Height="12"
                                                 Fill="#A1A1AA"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 10 0"/>
                                        <TextBlock x:Name="VpnInlineStatusText"
                                                   FontSize="15" FontWeight="Medium"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"
                                                   Text="Checking..."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Connect"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0 0 8 0"
                                                Click="VpnConnect_Click"/>
                                        <Button Content="Disconnect"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="VpnDisconnect_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource BrushBackground}"
                                        CornerRadius="6" Padding="12 10" Margin="0 0 0 8">
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Text="When connected to a suspicious or unknown network, the app will automatically attempt to connect your VPN. If VPN connection fails on a high-risk network, internet access will be blocked to protect you."/>
                                </Border>

                                <Button Content="Refresh status"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Click="VpnStatus_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Setup guide card -->
                        <Border Style="{StaticResource Card}" Margin="0 0 0 14">
                            <StackPanel>
                                <TextBlock Text="VPN setup guide"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0 0 0 4"/>
                                <TextBlock Text="Follow these steps to configure your VPN for automatic protection."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0 0 0 16"/>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#EFF6FF" Margin="0 0 10 0">
                                        <TextBlock Text="1" FontSize="11" FontWeight="Medium" Foreground="#185FA5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Install WireGuard" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Download WireGuard from wireguard.com and install it on your device."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#EFF6FF" Margin="0 0 10 0">
                                        <TextBlock Text="2" FontSize="11" FontWeight="Medium" Foreground="#185FA5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Get a WireGuard config" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Obtain a .conf file from your VPN provider (e.g. ProtonVPN, Mullvad) or generate one from your own WireGuard server."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#EFF6FF" Margin="0 0 10 0">
                                        <TextBlock Text="3" FontSize="11" FontWeight="Medium" Foreground="#185FA5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Load config template" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="In Advanced configuration below, click 'WireGuard template' then update the file path to point to your .conf file."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#EFF6FF" Margin="0 0 10 0">
                                        <TextBlock Text="4" FontSize="11" FontWeight="Medium" Foreground="#185FA5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Save and test" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Save config with your master key, then click Connect to verify it works."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Advanced configuration (collapsible) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Button x:Name="VpnAdvancedToggleBtn"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Cursor="Hand" Padding="0"
                                        Click="VpnAdvancedToggle_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Advanced configuration"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="VPN commands and mode settings"
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="VpnAdvancedChevron"
                                                   Text="▼" FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <StackPanel x:Name="VpnAdvancedContent"
                                            Visibility="Collapsed"
                                            Margin="0 16 0 0">

                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                        <Button Content="WireGuard template"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0 0 8 0"
                                                Click="FillWireGuardTemplate_Click"/>
                                        <Button Content="OpenVPN template"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="FillOpenVpnTemplate_Click"/>
                                    </StackPanel>

                                    <Border x:Name="VpnConfigHintBorder"
                                            CornerRadius="6" Padding="10 8"
                                            Margin="0 0 0 12"
                                            Visibility="Collapsed"
                                            Background="#FFFBEB"
                                            BorderBrush="#FCD34D"
                                            BorderThickness="1">
                                        <TextBlock x:Name="VpnConfigHintText"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="#92400E"/>
                                    </Border>

                                    <TextBlock Text="VPN mode" FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               Margin="0 0 0 6"/>
                                    <ComboBox x:Name="VpnModeComboBox"
                                              Width="200" HorizontalAlignment="Left"
                                              Margin="0 0 0 16" FontSize="13">
                                        <ComboBoxItem Content="Auto"/>
                                        <ComboBoxItem Content="WireGuard"/>
                                        <ComboBoxItem Content="OpenVpn"/>
                                    </ComboBox>

                                    <TextBlock Text="WireGuard" FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               Margin="0 0 0 8"/>
                                    <StackPanel Margin="0 0 0 12">
                                        <TextBlock Text="Connect command" FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   Margin="0 0 0 4"/>
                                        <TextBox x:Name="WgConnectTextBox"
                                                 FontFamily="Consolas" FontSize="11"
                                                 Padding="10 8" TextWrapping="Wrap" Height="52"/>
                                        <TextBlock Text="Disconnect command" FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   Margin="0 8 0 4"/>
                                        <TextBox x:Name="WgDisconnectTextBox"
                                                 FontFamily="Consolas" FontSize="11"
                                                 Padding="10 8" TextWrapping="Wrap" Height="52"/>
                                    </StackPanel>

                                    <TextBlock Text="OpenVPN" FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               Margin="0 0 0 8"/>
                                    <StackPanel Margin="0 0 0 16">
                                        <TextBlock Text="Connect command" FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   Margin="0 0 0 4"/>
                                        <TextBox x:Name="OvConnectTextBox"
                                                 FontFamily="Consolas" FontSize="11"
                                                 Padding="10 8" TextWrapping="Wrap" Height="52"/>
                                        <TextBlock Text="Disconnect command" FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   Margin="0 8 0 4"/>
                                        <TextBox x:Name="OvDisconnectTextBox"
                                                 FontFamily="Consolas" FontSize="11"
                                                 Padding="10 8" TextWrapping="Wrap" Height="52"/>
                                    </StackPanel>

                                    <Button Content="Save configuration"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left"
                                            Click="VpnConfigUpdate_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══════ SETTINGS PAGE ═══════ -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20">
                        <!-- ── DETECTION PROFILE CARD ── -->
                        <Border Style="{StaticResource Card}" Margin="0 0 0 14">
                            <StackPanel>
                                <TextBlock Text="Detection profile"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0 0 0 4"/>
                                <TextBlock Text="Choose the environment that best describes your setup."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 0 0 16"/>

                                <!-- Profile comparison table -->
                                <Border Background="#F4F4F5" CornerRadius="8"
                                        Margin="0 0 0 16"
                                        BorderBrush="#E4E4E7" BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Padding="14 12"
                                                BorderBrush="#E4E4E7" BorderThickness="0 0 0 1"
                                                Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#185FA5" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Home" FontSize="13" FontWeight="Medium"
                                                           Foreground="#18181B" VerticalAlignment="Center" Margin="8 0 0 0"/>
                                                <TextBlock Grid.Column="2" Text="Personal use · 1-3 APs · Strict detection"
                                                           FontSize="11" TextWrapping="Wrap" Foreground="#71717A" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3" CornerRadius="20" Padding="8 3" Background="#EFF6FF">
                                                    <TextBlock Text="2h learning" FontSize="10" FontWeight="Medium" Foreground="#185FA5"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Padding="14 12"
                                                BorderBrush="#E4E4E7" BorderThickness="0 0 0 1"
                                                Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#3B6D11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Enterprise" FontSize="13" FontWeight="Medium"
                                                           Foreground="#18181B" VerticalAlignment="Center" Margin="8 0 0 0"/>
                                                <TextBlock Grid.Column="2" Text="Office network · 10-100 APs · Balanced detection"
                                                           FontSize="11" TextWrapping="Wrap" Foreground="#71717A" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3" CornerRadius="20" Padding="8 3" Background="#F0FDF4">
                                                    <TextBlock Text="72h learning" FontSize="10" FontWeight="Medium" Foreground="#3B6D11"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Padding="14 12" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#854F0B" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Campus" FontSize="13" FontWeight="Medium"
                                                           Foreground="#18181B" VerticalAlignment="Center" Margin="8 0 0 0"/>
                                                <TextBlock Grid.Column="2" Text="University · 50+ APs · Tolerant of dense environments"
                                                           FontSize="11" TextWrapping="Wrap" Foreground="#71717A" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3" CornerRadius="20" Padding="8 3" Background="#FFFBEB">
                                                    <TextBlock Text="72h learning" FontSize="10" FontWeight="Medium" Foreground="#854F0B"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SettingsDeploymentProfileComboBox"
                                              Grid.Column="0"
                                              FontSize="13"
                                              Margin="0 0 8 0"
                                              SelectionChanged="SettingsProfileComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Home"/>
                                        <ComboBoxItem Content="Enterprise"/>
                                        <ComboBoxItem Content="Campus"/>
                                    </ComboBox>
                                    <Button Grid.Column="1"
                                            Content="Apply profile"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ApplyDeploymentProfile_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── PROFILE MANAGEMENT CARD ── -->
                        <Border Style="{StaticResource Card}" Margin="0 0 0 14">
                            <StackPanel>
                                <TextBlock Text="Profile management"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0 0 0 4"/>
                                <TextBlock Text="Export your trusted networks and learned profiles to a portable encrypted file. Share with other devices using the same master key."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="0 0 0 16"/>

                                <!-- Export section -->
                                <TextBlock Text="Export" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0 0 0 8"/>
                                <Button Content="Export .rapf"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0 0 0 12"
                                        Click="ExportProfile_Click"/>
                                <!-- Hidden stub for code-behind compatibility -->
                                <TextBox x:Name="ExportDescriptionBox" Visibility="Collapsed"/>

                                <!-- Import section -->
                                <TextBlock Text="Import" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0 0 0 8"/>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                    <Button Content="Select .rapf file"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="SelectRapfFile_Click"
                                            Margin="0 0 8 0"/>
                                    <TextBlock x:Name="SelectedRapfFileText"
                                               Text="No file selected"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Preview result card -->
                                <Border x:Name="RapfPreviewCard"
                                        CornerRadius="6" Padding="12"
                                        Margin="0 0 0 12"
                                        Visibility="Collapsed"
                                        Background="#F0FDF4"
                                        BorderBrush="#86EFAC"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="RapfPreviewTitle"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="#166534"
                                                   Margin="0 0 0 4"/>
                                        <TextBlock x:Name="RapfPreviewDetail"
                                                   FontSize="11"
                                                   Foreground="#3B6D11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 0">
                                    <CheckBox x:Name="ImportMergeMode"
                                              Content="Merge with existing (keep current trusted networks)"
                                              IsChecked="True"
                                              FontSize="12"
                                              Foreground="{StaticResource BrushTextSecondary}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                    <Button Content="Preview"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="PreviewRapf_Click"
                                            Margin="0 0 8 0"/>
                                    <Button Content="Import"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ImportRapf_Click"/>
                                </StackPanel>

                                <!-- Result feedback -->
                                <Border x:Name="ProfileActionResultCard"
                                        CornerRadius="6" Padding="12"
                                        Margin="0 12 0 0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ProfileActionResultText"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
            <!-- END PAGE CONTENT -->

        </Grid>

        <!-- ═══════ FIRST-RUN SETUP OVERLAY ═══════ -->
        <Grid x:Name="SetupOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="#F4F4F5"
              Panel.ZIndex="100">
            <Border MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E4E4E7"
                    BorderThickness="1"
                    Padding="32">
                <StackPanel>
                    <Image Source="Assets/logo-full.png"
                           Height="56"
                           Width="Auto"
                           MaxWidth="260"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 20"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"/>
                    <TextBlock Text="Welcome to RogueAP Shield"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="#18181B"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Before you begin, you need to set up a master key. This key protects your trusted network list and app settings."
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="#71717A"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock x:Name="SetupStepText"
                               Text="Step 1 of 4 — Choose your environment"
                               FontSize="12" FontWeight="Medium"
                               Foreground="#185FA5"
                               Margin="0,0,0,16"/>

                    <!-- Step 0: Choose profile -->
                    <StackPanel x:Name="SetupStep0">
                        <TextBlock Text="What best describes your environment?"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="#18181B" Margin="0 0 0 16"/>

                        <Border x:Name="ProfileCardHome"
                                CornerRadius="8" Padding="14 12"
                                Margin="0 0 0 8" Cursor="Hand"
                                BorderThickness="2" BorderBrush="#E4E4E7"
                                Background="White"
                                MouseLeftButtonDown="ProfileCardHome_MouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#E4E4E7"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F4F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                    <Border Width="28" Height="20" CornerRadius="4"
                                            Background="#EFF6FF" Margin="0 0 8 0">
                                        <TextBlock Text="HM" FontSize="9" FontWeight="Medium"
                                                   Foreground="#185FA5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Home" FontSize="13" FontWeight="Medium" Foreground="#18181B"/>
                                </StackPanel>
                                <TextBlock Text="Personal network with 1-3 access points. Learns your network in 2 hours."
                                           FontSize="11" TextWrapping="Wrap" Foreground="#71717A"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ProfileCardEnterprise"
                                CornerRadius="8" Padding="14 12"
                                Margin="0 0 0 8" Cursor="Hand"
                                BorderThickness="2" BorderBrush="#E4E4E7"
                                Background="White"
                                MouseLeftButtonDown="ProfileCardEnterprise_MouseLeftButtonDown">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                    <Border Width="28" Height="20" CornerRadius="4"
                                            Background="#F0FDF4" Margin="0 0 8 0">
                                        <TextBlock Text="EN" FontSize="9" FontWeight="Medium"
                                                   Foreground="#3B6D11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Enterprise" FontSize="13" FontWeight="Medium" Foreground="#18181B"/>
                                </StackPanel>
                                <TextBlock Text="Office or corporate network with many access points. Learns your network in 72 hours."
                                           FontSize="11" TextWrapping="Wrap" Foreground="#71717A"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ProfileCardCampus"
                                CornerRadius="8" Padding="14 12"
                                Margin="0 0 0 8" Cursor="Hand"
                                BorderThickness="2" BorderBrush="#E4E4E7"
                                Background="White"
                                MouseLeftButtonDown="ProfileCardCampus_MouseLeftButtonDown">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                    <Border Width="28" Height="20" CornerRadius="4"
                                            Background="#FFFBEB" Margin="0 0 8 0">
                                        <TextBlock Text="CA" FontSize="9" FontWeight="Medium"
                                                   Foreground="#854F0B"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Campus" FontSize="13" FontWeight="Medium" Foreground="#18181B"/>
                                </StackPanel>
                                <TextBlock Text="University or large public network with 10+ access points. Learns your network in 72 hours."
                                           FontSize="11" TextWrapping="Wrap" Foreground="#71717A"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SetupProfileContinueBtn"
                                Content="Continue"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0 10"
                                Margin="0 8 0 0"
                                IsEnabled="False"
                                Click="SetupContinueStep0_Click"/>
                    </StackPanel>

                    <!-- Step 1: Enter master key -->
                    <StackPanel x:Name="SetupStep1" Visibility="Collapsed">
                        <TextBlock Text="Master key" FontSize="12"
                                   Foreground="#71717A" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="SetupMasterKeyBox"
                                     FontSize="13" Padding="10,8"
                                     Margin="0,0,0,6"/>
                        <TextBlock Text="Must be at least 8 characters."
                                   FontSize="11" Foreground="#A1A1AA"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="Confirm master key" FontSize="12"
                                   Foreground="#71717A" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="SetupConfirmMasterKeyBox"
                                     FontSize="13" Padding="10,8"
                                     Margin="0,0,0,6"/>
                        <TextBlock x:Name="SetupMasterKeyMatchError"
                                   Text="Keys do not match."
                                   FontSize="11" Foreground="#A32D2D"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,12"/>
                        <Button Content="Continue"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"
                                Click="SetupContinueStep1_Click"/>
                    </StackPanel>

                    <!-- Step 2: Show recovery key -->
                    <StackPanel x:Name="SetupStep2" Visibility="Collapsed">
                        <TextBlock Text="Your recovery key"
                                   FontSize="12" Foreground="#71717A"
                                   Margin="0,0,0,6"/>
                        <Border Background="#F4F4F5" CornerRadius="6"
                                Padding="12" Margin="0,0,0,8">
                            <TextBlock x:Name="SetupRecoveryKeyText"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="#18181B"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="Save this key somewhere safe (e.g. a password manager or secure note). You will need it if you forget your master key. You cannot recover it later."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="#854F0B"
                                   Margin="0,0,0,20"/>
                        <Button Content="I have saved my recovery key"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"
                                Click="SetupContinueStep2_Click"/>
                    </StackPanel>

                    <!-- Step 3: Confirm recovery key -->
                    <StackPanel x:Name="SetupStep3" Visibility="Collapsed">
                        <TextBlock Text="Confirm your recovery key"
                                   FontSize="12" Foreground="#71717A"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="SetupConfirmRecoveryBox"
                                 FontFamily="Consolas" FontSize="13"
                                 Padding="10,8" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SetupConfirmError"
                                   FontSize="11" Foreground="#A32D2D"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,8"/>
                        <Button Content="← Back to recovery key"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#71717A"
                                FontSize="12"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Margin="0 0 0 8"
                                Click="SetupBackToStep2_Click"/>
                        <Button Content="Complete setup"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"
                                Click="SetupComplete_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="SetupStatusText"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</Window>
