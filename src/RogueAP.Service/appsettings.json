{
  "Protection": {
    "ScanIntervalSeconds": 10,
    "AlertOnlyOnTrustedNetworks": true,
    "EnableHardBlockOnCritical": true,
    "AutoAttemptVpnOnMediumUntrusted": false,
    "AutoAttemptVpnOnHighUntrusted": true,
    "DeploymentProfile": "Home",
    "LearningDurationHoursHome": 1,
    "LearningDurationHoursEnterprise": 72,
    "LearningDurationHoursCampus": 72
  },
  "WifiScanner": {
    "UseNetshScanner": true,
    "SignalHistoryLimit": 6
  },
  "Vpn": {
    "Mode": "Auto",
    "WireGuardConnectCommand": "",
    "WireGuardDisconnectCommand": "",
    "OpenVpnConnectCommand": "",
    "OpenVpnDisconnectCommand": "",
    "CommandTimeoutSeconds": 20,
    "MaxCommandRetries": 2,
    "RetryDelaySeconds": 2,
    "EnableCommandValidation": true,
    "UseVendorProcessAsConnectedFallback": true,
    "BlockedCommandTokens": [
      "Remove-Item",
      "Remove-ItemProperty",
      "Format-Volume",
      "diskpart",
      "Stop-Computer",
      "Restart-Computer",
      "shutdown",
      "net user",
      "sc delete",
      "reg delete"
    ],
    "TunnelInterfaceHints": [
      "WireGuard",
      "Wintun",
      "TAP",
      "TUN"
    ],
    "VendorStatusProcessNames": [
      "nordvpn",
      "surfshark",
      "expressvpn",
      "protonvpn",
      "tunnelbear"
    ]
  },
  "Enforcement": {
    "UseWindowsFirewall": true,
    "DryRun": false,
    "FirewallRuleName": "RogueAP_BlockAllOutbound"
  },
  "SecureStorage": {
    "DataDirectory": "",
    "TrustedNetworksFileName": "trusted-networks.secure.json",
    "MasterKeyStateFileName": "master-key-state.secure.json",
    "SeedDefaultTrustedNetworks": false
  },
  "Notifications": {
    "EnableWindowsNotifications": true,
    "UseBurntToastModule": true,
    "EnableMsgFallback": true,
    "MsgTimeoutSeconds": 15,
    "PopupMediumOrHigherOnly": true,
    "NotifyImmediatelyOnSeverityIncrease": true,
    "RepeatAfterFirstMinutes": 5,
    "RepeatAfterSecondMinutes": 15,
    "RepeatAfterThirdMinutes": 30,
    "ResetAfterQuietMinutes": 60
  },
  "ControlApi": {
    "Enabled": true,
    "Url": "http://127.0.0.1:5088"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
